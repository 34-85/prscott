# PetGuardian server environment
PORT=4000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/pettrust
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/pettrust_test

# Auth
JWT_SECRET=change-me-in-production-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS origin for the client
CLIENT_ORIGIN=http://localhost:5173
