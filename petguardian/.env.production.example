# Copy to .env for `docker compose up`. Do NOT commit the real .env.

# --- Postgres (the db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pettrust

# --- App ---
# Host port to expose the app on (container always listens on 4000).
APP_PORT=4000
# REQUIRED: a long random string. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
