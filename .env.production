# Production Supabase config for cloud sync + accounts.
#
# These two values are PUBLIC by design: the publishable key is meant to ship in
# the client, and each user's data is protected by row-level security in the
# database — not by keeping this key hidden. Loaded automatically by `vite build`
# (both the web and iOS builds), so accounts work everywhere with no extra setup.
#
# The *secret* key (sb_secret_…) must never appear here or anywhere in the app.

VITE_SUPABASE_URL=https://tmynaoyhucptpqszwsxu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_2uL8DhOFlKj0bTtpsyMI5w_EeC2cns1
