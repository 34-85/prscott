# Cloud sync + accounts (optional).
#
# The app runs fully local (no accounts, everything in the browser) until BOTH
# of these are set. Copy this file to `.env.local` and fill them in with the
# values from your Supabase project (Settings → API):
#
#   VITE_SUPABASE_URL     = the "Project URL"
#   VITE_SUPABASE_ANON_KEY = the "anon" / "publishable" key
#
# The anon key is designed to be shipped in the client — row-level security in
# the database is what protects each user's data. Never put the *service* key
# here; it bypasses security and must stay server-side only.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
